{
  "name": "pipo-study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "prepare": "husky",
    "test:int": "vitest run --config vitest.int.config.mts",
    "test:e2e": "playwright test",
    "dict:import": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/import-jmdict.mts",
    "docker:up": "docker compose --env-file .env.local up --build",
    "icons": "node --experimental-strip-types --no-warnings scripts/generate-icons.mts",
    "ai:eval": "vitest run --config vitest.eval.config.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "kuromoji": "^0.1.2",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,mts}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
