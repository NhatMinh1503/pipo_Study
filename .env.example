# Copy to .env.local and fill in. Never commit .env.local.
# Local values: run `supabase status` after `supabase start`.

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=
LOG_LEVEL=info

# AI grading (Google AI Studio → Get API key). Without a key, AI routes answer AI_NOT_CONFIGURED.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Max AI calls per user per day — keep the total inside the free tier
AI_DAILY_LIMIT=150
